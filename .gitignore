# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
build/
dist/

# Raw and processed data (large) — the sample + stats ARE committed
data/raw/
data/processed/*.bin
data/processed/*.txt
data/processed/*.json

# Training checkpoints (heavy) — final fp16 artifact IS committed
artifacts/training/last.pt
artifacts/training/best.pt
artifacts/smoke/

# Environments / IDE / OS
.idea/
.vscode/
.DS_Store
*.log

# v1.1 working data (large) — release artifacts live in artifacts/training/
data/processed_v2/
artifacts/training_v2/

# v1.2 working data (large) — release artifacts live in artifacts/training_v3/
data/processed_v3/
artifacts/training_v3/last.pt
artifacts/training_v3/best.pt
artifacts/training_v3/*.tmp

# v1.4/v1.5/v1.6 working data (large) — release artifacts live in artifacts/training_v4/
data/processed_v4/
artifacts/training_v4/last.pt
artifacts/training_v4/best.pt
artifacts/training_v4/*.tmp

# منقحة fikr layer: the full (non-core) knowledge DB stays local
data/knowledge/ryko-full.sqlite
data/knowledge/ryko-full.receipt.json

# v1.12 working data (large) — release artifacts live in artifacts/training_v5/
data/processed_v5/train.bin
data/processed_v5/val.bin
data/processed_v5/*.binarize_state.json
artifacts/training_v5/last.pt
artifacts/training_v5/best.pt
artifacts/training_v5/*.tmp

# v1.15 linguistics pack (طبقة اللغة) — stats + receipt ARE committed
data/processed_ling/train.txt
data/processed_ling/val.txt
data/processed_ling/*.bin
data/processed_ling/*.binarize_state.json
artifacts/training_ling_shard/
artifacts/training_small_ling/

# Training checkpoints (heavy) — final fp16 artifact IS committed
artifacts/training_v5b/last.pt
artifacts/training_v5b/best.pt

# v1.15 working data (large) — receipts + stats ARE committed; bins/tmp are not
data/processed_v52/train.bin
data/processed_v52/val.bin
data/processed_v52/*.binarize_state.json
data/processed_v52/_all_docs.tmp.txt
data/bench/palmx_ic_source.parquet
artifacts/training_v5c/last.pt
artifacts/training_v5c/best.pt

# turath layer: the full (non-core) wide-selection DB stays local —
# its RECEIPT is committed (rebuildable via make turath-collect && make turath-build-full)
data/knowledge/ryko-wide-full.sqlite

# Resumable training state + derived token streams (rebuildable via pack_sft;
# only final.pt milestones + receipts + logs/summaries are committed)
artifacts/*/last.pt
artifacts/*/best.pt
artifacts/*/*.bin
artifacts/*/*.pt.tmp

# v1.22 unified verify store + receipt (local, rebuildable via lugha-build-full on a core copy)
data/knowledge/ryko-verify-full.sqlite
data/knowledge/ryko-verify-full.receipt.json

# v1.23 DPO round-2 working checkpoint (final fp16 artifact IS committed)
artifacts/dpo_round2_small/last.pt

# v1.25 argrel proof shard — final.pt + receipt ARE committed; resumable state is not
artifacts/proof_argrel_small/last.pt
artifacts/proof_argrel_small/best.pt

# v1.28.0 derived search-index sidecar (serving cold-start cache)
data/knowledge/*.vecs.cache.pkl
data/knowledge/*.vecs.cache.pkl.tmp
