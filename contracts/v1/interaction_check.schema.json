{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://medical-ai.local/schemas/v1/interaction_check.json",
  "title": "Interaction Check (pharma KB)",
  "type": "object",
  "$comment": "مسودة v0 — تُعتمد في W0. العلم التنظيمي pharma.interactions مطفأ حتى توقيع ترخيص KB (Lexicomp/Micromedex/FDB)؛ كل استدعاء قبل التفعيل يعيد 409. الصياغة المسموحة: «تنبيه لتداخل معروف بين دوائين — راجع صيدليك» ولا يجوز «يصف العلاج الآمن».",
  "required": ["kb_vendor", "kb_version", "inputs_hash", "status", "pairs"],
  "properties": {
    "kb_vendor": { "type": "string", "description": "مزود قاعدة المعرفة المرخّص" },
    "kb_version": { "type": "string" },
    "inputs_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$", "description": "SHA-256 لمدخلات الفحص — يخزن في interaction_check.inputs_hash" },
    "status": { "type": "string", "enum": ["ok", "abstain", "disabled"] },
    "pairs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["atc_a", "atc_b", "severity"],
        "properties": {
          "atc_a": { "type": "string", "pattern": "^[A-Z][0-9]{2}[A-Z]{2}[0-9]{2}$", "description": "ATC كود الدواء الأول (مثال: B01AA03 وارفارين)" },
          "atc_b": { "type": "string", "pattern": "^[A-Z][0-9]{2}[A-Z]{2}[0-9]{2}$" },
          "severity": { "type": "string", "enum": ["contraindicated", "major", "moderate", "minor", "unknown"] },
          "effect_text": { "type": "string", "description": "نص قاعدة المعرفة حرفياً — بلا صياغة تشخيصية أو توصية جرعة" },
          "source_ref": { "type": "string", "description": "مرجع داخل KB (entry id / page)" },
          "disclaimer": { "type": "string" }
        }
      }
    },
    "allergy_cross_check": {
      "type": "object",
      "properties": {
        "performed": { "type": "boolean" },
        "hits": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["allergen", "atc_code"],
            "properties": {
              "allergen": { "type": "string" },
              "atc_code": { "type": "string", "pattern": "^[A-Z][0-9]{2}[A-Z]{2}[0-9]{2}$" }
            }
          }
        }
      }
    }
  }
}
